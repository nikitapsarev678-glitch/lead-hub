<Page x:Class="LeadHub.App.Views.LeadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Лиды">
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,8,0,10">
            <TextBlock Text="Лиды" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Пишешь вручную: скопируй текст, открой WhatsApp/Telegram, отметь «Написал» после видимой отправки."
                       Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <ui:Card Grid.Row="1" Margin="0,0,0,10" Padding="12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ui:Button Content="Экспорт CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="HTML-хелпер" Appearance="Primary" Command="{Binding ExportHtmlCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding SectionLabels}" SelectedIndex="{Binding SectionIndex}" Width="220" Margin="0,0,8,0" />
                    <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Поиск: бизнес, город, ниша, телефон" Width="280" />
                </StackPanel>
            </DockPanel>
        </ui:Card>

        <ui:Card Grid.Row="2" Padding="4">
            <DataGrid ItemsSource="{Binding Leads}" AutoGenerateColumns="False" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="52">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Бизнес" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="4">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding FullName}" />
                                    <TextBlock FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis">
                                        <Run Text="@" /><Run Text="{Binding Handle, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding City, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Niche, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Контакты" Width="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="4">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="Instagram" FontSize="11" Margin="0,0,6,0"
                                                   Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding InstagramUrl}" />
                                        <ui:Button Content="WhatsApp" FontSize="11" Margin="0,0,6,0" Appearance="Primary"
                                                   Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding WhatsappUrl}" />
                                        <ui:Button Content="Telegram" FontSize="11"
                                                   Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding TelegramUrl}" />
                                    </StackPanel>
                                    <TextBlock FontSize="11" Opacity="0.8">
                                        <Run Text="{Binding Phone, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding WhatsappStatus, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Текст сообщения" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="4">
                                    <TextBox Text="{Binding OutreachText, UpdateSourceTrigger=LostFocus}"
                                             LostFocus="OutreachText_LostFocus" TextWrapping="Wrap" MaxHeight="60" />
                                    <ui:Button Content="Скопировать текст" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Left"
                                               Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Написал" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Sent, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleSentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ui:Card>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,8,0,0" Opacity="0.85" TextWrapping="Wrap" />
    </Grid>
</Page>
