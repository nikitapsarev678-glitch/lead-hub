<Page x:Class="LeadHub.App.Views.VpnHubPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="VPN">
    <ScrollViewer Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,24,0,0">

            <TextBlock Text="VPN Hub" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Импортируйте vless:// ссылки или подписку — как в Happ. Пинги в мс, слоты с разными IP для аккаунтов."
                       Opacity="0.7" Margin="0,4,0,16" />

            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Импорт узлов" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ui:TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" Height="90"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             PlaceholderText="Вставьте vless:// ссылки (по одной в строке), весь список или URL подписки (https://…)" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="Импортировать" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Выгрузить ссылки" Icon="{ui:SymbolIcon ArrowExportLtr24}" Command="{Binding ExportLinksCommand}" Margin="0,0,8,0" />
                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Ядро" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Запустить sing-box" Appearance="Primary" Command="{Binding StartVpnCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Стоп" Command="{Binding StopVpnCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Проверить пинги" Command="{Binding PingAllCommand}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding VpnStatus}" Opacity="0.8" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12" Padding="8">
                <DataGrid ItemsSource="{Binding Nodes}" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" HeadersVisibility="Column" MinHeight="200" MaxHeight="420"
                          GridLinesVisibility="Horizontal" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Страна" Width="170">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="Flag" />
                                    <Binding Path="CountryName" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Узел" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Протокол" Binding="{Binding TransportLabel}" Width="150" />
                        <DataGridTextColumn Header="Сервер" Width="150">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0}:{1}">
                                    <Binding Path="Server" />
                                    <Binding Path="Port" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Пинг" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastLatencyMs}" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastLatencyMs}" Value="-1">
                                                        <Setter Property="Text" Value="—" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Использований" Binding="{Binding UseCount}" Width="110" />
                        <DataGridTemplateColumn Header="Вкл" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" HorizontalAlignment="Center"
                                              Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="Удалить" FontSize="11"
                                               Command="{Binding DataContext.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ui:Card>

            <ui:Card Margin="0,0,0,24" Padding="16">
                <StackPanel>
                    <TextBlock Text="Слоты — каждому аккаунту свой IP" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="Слот = локальный прокси-порт. Воркер парсинга со слотом N выходит в интернет через выбранное ниже соединение."
                               Opacity="0.7" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="230" Margin="0,0,10,10" Padding="10"
                                        BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="Слот " /><Run Text="{Binding Index}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Opacity="0.6" Margin="0,0,0,6">
                                            <Run Text="socks5://127.0.0.1:" /><Run Text="{Binding Port}" />
                                        </TextBlock>
                                        <ComboBox ItemsSource="{Binding DataContext.SlotChoices, RelativeSource={RelativeSource AncestorType=Page}}"
                                                  SelectedItem="{Binding AssignedNode, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="SlotSelectionChanged" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
