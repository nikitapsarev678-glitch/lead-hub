<Page x:Class="LeadHub.App.Views.RunPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Прогон">
    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,8,0,12">
            <TextBlock Text="Прогон" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VpnStatus}" Opacity="0.7" />
        </StackPanel>

        <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Лидов найдено" Opacity="0.7" />
                    <TextBlock Text="{Binding Leads}" FontSize="34" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Профилей проверено" Opacity="0.7" />
                    <TextBlock Text="{Binding Validated}" FontSize="34" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Статус" Opacity="0.7" />
                    <TextBlock FontSize="20" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="⏹ остановлен" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Text" Value="▶️ идёт" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <ui:Button Grid.Column="3" Content="⏹ Остановить" Appearance="Danger" VerticalAlignment="Center"
                           Command="{Binding StopCommand}" />
            </Grid>
        </ui:Card>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <ui:Card Padding="8" Margin="0,0,12,0" VerticalAlignment="Stretch">
                <ListBox ItemsSource="{Binding Workers}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="2" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="Слот " /><Run Text="{Binding SlotIndex, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Margin="10,0,0,0" Opacity="0.8">
                                            <Run Text="{Binding Account, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding VpnLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding CurrentQuery, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Opacity="0.9">
                                        <Run Text="{Binding State, Mode=OneWay}" /><Run Text=" · найдено " /><Run Text="{Binding Leads, Mode=OneWay}" /><Run Text=" · проверено " /><Run Text="{Binding Validated, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ui:Card>

            <ui:Card Padding="8" VerticalAlignment="Stretch">
                <ListBox x:Name="LogBox" ItemsSource="{Binding LogLines}" BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </ui:Card>
        </Grid>
    </Grid>
</Page>
