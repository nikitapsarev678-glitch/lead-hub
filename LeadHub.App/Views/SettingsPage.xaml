<Page x:Class="LeadHub.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Настройки">
    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Margin="0,24,0,0" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Ядро sing-box" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Положите sing-box.exe в tools/sing-box/ рядом с программой — он подхватится автоматически. Или укажите путь вручную."
                               Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding SingBoxPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="C:\tools\sing-box\sing-box.exe" />
                        <ui:Button Grid.Column="1" Content="Обзор…" Margin="8,0,0,0" Command="{Binding BrowseSingBoxCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Данные" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Content="Открыть папку данных" Command="{Binding OpenDataDirCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Открыть папку экспорта" Command="{Binding OpenExportDirCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Резервная копия БД" Command="{Binding BackupDatabaseCommand}" />
                    </StackPanel>
                    <TextBlock Text="База: leadhub.db — лиды, аккаунты (cookies зашифрованы AES-GCM), VPN-узлы, статистика."
                               Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Импорт исключений из скилла" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Загрузите exclusions.json из прошлого пайплайна — все выданные ранее handles и телефоны исключатся из новых прогонов (дедупликация)."
                               Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ui:Button Content="Выбрать exclusions.json" Command="{Binding ImportExclusionsCommand}" />
                </StackPanel>
            </ui:Card>

            <TextBlock Text="{Binding Status}" Opacity="0.85" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</Page>
